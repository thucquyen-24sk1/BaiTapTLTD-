<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="THÊM KHOẢN CHI MỚI"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/edtTenKhoanChi_115"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên khoản chi"
        android:inputType="text"/>

    <EditText
        android:id="@+id/edtSoTien_115"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập số tiền"
        android:inputType="numberDecimal"/>

    <EditText
        android:id="@+id/edtGhiChu_115"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập ghi chú"
        android:inputType="text"/>

    <Button
        android:id="@+id/btnThemKhoanChi_115"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm khoản chi"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnXemChiTiet_115"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xem chi tiết khoản chi"
        android:layout_marginTop="8dp"/>
    <EditText
        android:id="@+id/edtLoaiChi_115"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập loại chi (Ăn uống, Đi lại, Học tập, Khác)"
        android:inputType="text" />
</LinearLayout>